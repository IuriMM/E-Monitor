# Por padrão o app usa o caminho relativo "/api", que é proxied para o
# backend real via vercel.json (produção) ou vite.config.js (dev).
# Só defina VITE_API_URL se quiser apontar direto para a API,
# sem passar pelo proxy (não recomendado: expõe o domínio do backend
# nas chamadas do navegador, o que pode disparar heurísticas de phishing
# em antivírus como o Kaspersky, já que é um form de login cross-origin
# entre dois domínios de hospedagem gratuita).
# VITE_API_URL=https://e-monitorwebapi.onrender.com/api

# Matrícula do único usuário que vê o botão/tela de painel administrativo
# (Cadastro). É só um filtro de interface — não substitui autorização real
# no backend, que ainda precisa ser implementada (ver proposta_autorizacao_api.md).
VITE_ADMIN_MATRICULA=admin
